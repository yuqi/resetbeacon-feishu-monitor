FEISHU_WEBHOOK_URL=
FEISHU_SIGNING_SECRET=

# en：只发原文；zh：只发中文（必须配置 OpenAI）；留空：原文和中文都发。
# 未配置 OpenAI 且语言留空时保持只发原文。
SEND_LANGUAGE=

# 三项全部配置后可发送中文译文；语言留空且未配置 OpenAI 时只发送原文。
# API 基础地址（含服务商要求的 /v1 等前缀，不含 /chat/completions）。
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# 可选；留空不传参数，沿用接口默认值。需服务商与模型支持对应档位。
OPENAI_REASONING_EFFORT=
TRANSLATION_TIMEOUT_SECONDS=60
TRANSLATION_MAX_RETRIES=3

RESET_BEACON_HISTORY_URL=https://resetbeacon.com/api/history
RESET_BEACON_ALERTS_URL=https://resetbeacon.com/api/alerts
RESET_BEACON_HEALTH_URL=https://resetbeacon.com/api/v1/health

STATE_DB_PATH=./data/monitor.sqlite3
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
LOG_LEVEL=INFO
